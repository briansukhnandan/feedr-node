#!/bin/sh
set -eu

PROGRAM_NAME=${0##*/}
FEEDR_CONFIG_FILE=${FEEDR_CONFIG_FILE:-/config/feedr-node.conf}
FEEDR_HOME=${FEEDR_HOME:-/feedr}
FEEDR_STATE_DIR=${FEEDR_STATE_DIR:-/var/lib/feedr-node}
FEEDR_SCRIPT_DIR=${FEEDR_SCRIPT_DIR:-/scripts}
FEEDR_SCRIPT_COMMAND=${FEEDR_SCRIPT_COMMAND:-}
FEEDR_FEED_ID=${FEEDR_FEED_ID:-}
FEEDR_CRON_STRING=${FEEDR_CRON_STRING:-}
FEEDR_TIMEZONE=${FEEDR_TIMEZONE:-UTC}

usage() {
  cat <<EOF
Usage:
  $PROGRAM_NAME init
  $PROGRAM_NAME publish <posts.json>
  $PROGRAM_NAME run

Commands:
  init      Prompt for a feed ID and five-field cron schedule.
  publish   Atomically publish a JSON file for the current day.
  run       Register the configured job and run cron in the foreground.
EOF
}

die() {
  printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2
  exit 1
}

drop_privileges_for_file_command() {
  requested_command=${1:-}
  case "$requested_command" in
    init|publish|_run-job) ;;
    *) return 0 ;;
  esac

  [ "${FEEDR_PRIVILEGES_DROPPED:-0}" != 1 ] || return 0
  [ "$(id -u)" -eq 0 ] || return 0
  [ -n "${FEEDR_UID:-}" ] || return 0
  case "$FEEDR_UID:${FEEDR_GID:-}" in
    *[!0-9:]*) die 'FEEDR_UID and FEEDR_GID must be numeric' ;;
    *:) die 'FEEDR_GID must be set when FEEDR_UID is set' ;;
  esac
  FEEDR_PRIVILEGES_DROPPED=1
  export FEEDR_PRIVILEGES_DROPPED
  exec su-exec "$FEEDR_UID:$FEEDR_GID" "$0" "$@"
}

load_config() {
  [ -f "$FEEDR_CONFIG_FILE" ] || return 0

  while IFS='=' read -r key value || [ -n "$key" ]; do
    case "$key" in
      ''|'#'*) ;;
      FEEDR_FEED_ID) FEEDR_FEED_ID=$value ;;
      FEEDR_CRON_STRING) FEEDR_CRON_STRING=$value ;;
      FEEDR_SCRIPT_DIR) FEEDR_SCRIPT_DIR=$value ;;
      FEEDR_SCRIPT_COMMAND) FEEDR_SCRIPT_COMMAND=$value ;;
      FEEDR_TIMEZONE) FEEDR_TIMEZONE=$value ;;
    esac
  done <"$FEEDR_CONFIG_FILE"
}

export_config() {
  export FEEDR_CONFIG_FILE FEEDR_HOME FEEDR_STATE_DIR
  export FEEDR_FEED_ID FEEDR_CRON_STRING FEEDR_SCRIPT_DIR
  export FEEDR_SCRIPT_COMMAND FEEDR_TIMEZONE
}

validate_feed_id() {
  [ -n "$FEEDR_FEED_ID" ] || die 'FEEDR_FEED_ID is not configured; run `feedr init`'
  case "$FEEDR_FEED_ID" in
    .|*/*|*\\*) die 'feed ID must not be "." or contain a path separator' ;;
    *[!A-Za-z0-9._-]*) die 'feed ID may contain only letters, numbers, dots, underscores, and hyphens' ;;
  esac
}

validate_cron() {
  [ -n "$FEEDR_CRON_STRING" ] || die 'FEEDR_CRON_STRING is not configured; run `feedr init`'
  case "$FEEDR_CRON_STRING" in
    *'
'*) die 'cron schedule must be a single line' ;;
  esac

  set -f
  old_ifs=$IFS
  IFS=' '
  # Accept the cron implementation's field syntax, but require the portable
  # five-field shape.
  set -- $FEEDR_CRON_STRING
  IFS=$old_ifs
  set +f
  [ "$#" -eq 5 ] || die 'cron schedule must contain exactly five fields'
}

prompt() {
  label=$1
  default=$2
  if [ -n "$default" ]; then
    printf '%s [%s]: ' "$label" "$default"
  else
    printf '%s: ' "$label"
  fi
  IFS= read -r answer || die 'input ended before initialization completed'
  if [ -n "$answer" ]; then
    REPLY=$answer
  else
    REPLY=$default
  fi
}

init_config() {
  load_config

  prompt 'Feed ID' "$FEEDR_FEED_ID"
  FEEDR_FEED_ID=$REPLY
  validate_feed_id

  prompt 'Cron schedule' "${FEEDR_CRON_STRING:-0 * * * *}"
  FEEDR_CRON_STRING=$REPLY
  validate_cron

  config_dir=${FEEDR_CONFIG_FILE%/*}
  [ "$config_dir" = "$FEEDR_CONFIG_FILE" ] && config_dir=.
  mkdir -p "$config_dir"
  config_tmp=$(mktemp "$config_dir/.feedr-node.conf.XXXXXX")
  trap 'rm -f "$config_tmp"' EXIT HUP INT TERM
  {
    printf '%s\n' '# Generated by `feedr init`. You may edit this file.'
    printf 'FEEDR_FEED_ID=%s\n' "$FEEDR_FEED_ID"
    printf 'FEEDR_CRON_STRING=%s\n' "$FEEDR_CRON_STRING"
    printf 'FEEDR_SCRIPT_DIR=%s\n' "$FEEDR_SCRIPT_DIR"
    printf 'FEEDR_SCRIPT_COMMAND=%s\n' "$FEEDR_SCRIPT_COMMAND"
    printf 'FEEDR_TIMEZONE=%s\n' "$FEEDR_TIMEZONE"
  } >"$config_tmp"
  chmod 0644 "$config_tmp"
  mv "$config_tmp" "$FEEDR_CONFIG_FILE"
  trap - EXIT HUP INT TERM

  printf 'Saved %s\n' "$FEEDR_CONFIG_FILE"
  if [ -z "$FEEDR_SCRIPT_COMMAND" ]; then
    printf '%s\n' 'Set FEEDR_SCRIPT_COMMAND in that file before running the node.'
  fi
}

publish() {
  [ "$#" -eq 1 ] || die 'usage: feedr publish <posts.json>'
  load_config
  validate_feed_id
  source_file=$1
  [ -f "$source_file" ] || die "input file does not exist: $source_file"

  jq -e 'type == "array" and all(.[]; type == "object" and (.id | type == "string" and length > 0))' \
    "$source_file" >/dev/null || die 'input must be a JSON array whose posts have non-empty string IDs'

  export TZ=$FEEDR_TIMEZONE
  today=$(date +%Y_%m_%d)
  target_dir=$FEEDR_HOME/$today/feeds/$FEEDR_FEED_ID
  target_file=$target_dir/posts.json
  mkdir -p "$target_dir"

  target_tmp=$(mktemp "$target_dir/.posts.json.XXXXXX")
  trap 'rm -f "$target_tmp"' EXIT HUP INT TERM
  cp "$source_file" "$target_tmp"
  chmod 0644 "$target_tmp"
  mv "$target_tmp" "$target_file"
  trap - EXIT HUP INT TERM
  printf 'Published %s\n' "$target_file"
}

run_job() {
  load_config
  validate_feed_id
  [ -n "$FEEDR_SCRIPT_COMMAND" ] || die 'FEEDR_SCRIPT_COMMAND is not configured'
  [ -d "$FEEDR_SCRIPT_DIR" ] || die "script directory does not exist: $FEEDR_SCRIPT_DIR"
  export_config
  cd "$FEEDR_SCRIPT_DIR"
  exec /bin/sh -c "$FEEDR_SCRIPT_COMMAND"
}

register_cron_job() {
  mkdir -p "$FEEDR_STATE_DIR"
  cron_tmp=$(mktemp "$FEEDR_STATE_DIR/.crontab.XXXXXX")
  trap 'rm -f "$cron_tmp"' EXIT HUP INT TERM
  {
    printf 'SHELL=/bin/sh\n'
    printf 'PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin\n'
    printf '%s /usr/local/bin/feedr _run-job >>/proc/1/fd/1 2>>/proc/1/fd/2\n' "$FEEDR_CRON_STRING"
  } >"$cron_tmp"
  crontab "$cron_tmp"
  rm -f "$cron_tmp"
  trap - EXIT HUP INT TERM
  : >"$FEEDR_STATE_DIR/cron.registered"
  printf 'Registered cron job: %s\n' "$FEEDR_CRON_STRING"
}

run_cron() {
  load_config
  validate_feed_id
  validate_cron
  [ -n "$FEEDR_SCRIPT_COMMAND" ] || die 'FEEDR_SCRIPT_COMMAND is not configured'
  [ -d "$FEEDR_SCRIPT_DIR" ] || die "script directory does not exist: $FEEDR_SCRIPT_DIR"

  registration_file=$FEEDR_STATE_DIR/cron.registered
  if [ "${FEEDR_REGISTERED_CRON_JOB:-0}" != 1 ] && [ ! -f "$registration_file" ]; then
    register_cron_job
  elif ! crontab -l >/dev/null 2>&1; then
    # Repair state if the cron spool was removed independently of the marker.
    register_cron_job
  fi

  FEEDR_REGISTERED_CRON_JOB=1
  export FEEDR_REGISTERED_CRON_JOB
  exec crond -f -l "${FEEDR_CRON_LOG_LEVEL:-2}"
}

drop_privileges_for_file_command "$@"
command=${1:-}
[ "$#" -eq 0 ] || shift
case "$command" in
  init) [ "$#" -eq 0 ] || die 'usage: feedr init'; init_config ;;
  publish) publish "$@" ;;
  run) [ "$#" -eq 0 ] || die 'usage: feedr run'; run_cron ;;
  _run-job) [ "$#" -eq 0 ] || die 'usage: feedr _run-job'; run_job ;;
  help|-h|--help|'') usage ;;
  *) die "unknown command: $command" ;;
esac
